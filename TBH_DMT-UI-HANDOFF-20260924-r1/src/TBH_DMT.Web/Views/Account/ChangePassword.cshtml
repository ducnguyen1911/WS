@model TBH_DMT.Web.Models.Requests.ChangePasswordRequest
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = "Đổi mật khẩu";
    ViewBag.PageTitle = "Đổi mật khẩu";
}
@section Styles {
    <link rel="stylesheet" href="@Url.Content("~/Content/admin/admin.css?v=20260913a")" />
}

<section class="app-page admin-page narrow">
<form id="change-password-form" class="app-surface app-surface-soft app-form-surface admin-form-card" method="post" action="@Url.Action("ChangePassword", "Account")" novalidate>
        @Html.AntiForgeryToken()
        <div class="admin-field">
            <label for="current-password">Mật khẩu hiện tại</label>
            <span class="password-control"><input id="current-password" name="CurrentPassword" type="password" autocomplete="current-password" aria-describedby="password-caps-lock" required /><button type="button" class="password-toggle" data-password-target="current-password" aria-label="Hiện mật khẩu hiện tại" aria-pressed="false"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M1 12s4-7 11-7 11 7 11 7-4 7-11 7S1 12 1 12z" /><circle cx="12" cy="12" r="3" /></svg></button></span>
        </div>
        <div class="admin-field">
            <label for="new-password">Mật khẩu mới</label>
            <span class="password-control"><input id="new-password" name="NewPassword" type="password" autocomplete="new-password" aria-describedby="new-password-rule password-caps-lock" minlength="6" required /><button type="button" class="password-toggle" data-password-target="new-password" aria-label="Hiện mật khẩu mới" aria-pressed="false"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M1 12s4-7 11-7 11 7 11 7-4 7-11 7S1 12 1 12z" /><circle cx="12" cy="12" r="3" /></svg></button></span>
            <small id="new-password-rule" class="password-hint">Mật khẩu mới phải có ít nhất 6 ký tự.</small>
        </div>
        <div class="admin-field">
            <label for="confirm-password">Xác nhận mật khẩu</label>
            <span class="password-control"><input id="confirm-password" name="ConfirmPassword" type="password" autocomplete="new-password" aria-describedby="password-match password-caps-lock" required /><button type="button" class="password-toggle" data-password-target="confirm-password" aria-label="Hiện mật khẩu xác nhận" aria-pressed="false"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M1 12s4-7 11-7 11 7 11 7-4 7-11 7S1 12 1 12z" /><circle cx="12" cy="12" r="3" /></svg></button></span>
            <small id="password-match" class="password-hint" role="status" aria-live="polite"></small>
        </div>
        <small id="password-caps-lock" class="password-hint warning" role="status" hidden>Caps Lock đang bật.</small>
        <div id="password-message" class="admin-alert" role="status" aria-live="polite" hidden></div>
        <button id="change-password-submit" type="submit" class="admin-btn primary">Đổi mật khẩu</button>
    </form>
</section>

@section Scripts {
    <script src="@Url.Content("~/Scripts/admin/change-password.js?v=20260919a")"></script>
}
